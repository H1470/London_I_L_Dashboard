# Copy to `backend/.env` and fill in (never commit `.env`).
CHATHAM_USERNAME=
CHATHAM_PASSWORD=

# Inbox → rolling news (optional). DB file: backend/data/news.db (gitignored).
# Microsoft 365: IMAP host is usually outlook.office365.com. If LOGIN fails with a
# correct password, the tenant may block basic auth — use an app password (MFA),
# or ask an admin to enable IMAP / SMTP AUTH for this mailbox. This client uses
# plain IMAP LOGIN, not OAuth2.
NEWS_IMAP_HOST=
NEWS_IMAP_USER=
NEWS_IMAP_PASSWORD=
# NEWS_IMAP_PORT=993
# NEWS_IMAP_FOLDER=INBOX
# Optional: require this value in header X-News-Sync-Secret when calling POST /api/news/sync
# NEWS_SYNC_SECRET=

# Newmark map / GeoJSON: 0-based column index in `master_all` for lat,lon strings (e.g. 51.5,-0.12).
# NEWMARK_COORD_COL_INDEX=7
# Newmark map — region (London / South East): use either a column name (matches SELECT … layout) or index.
# NEWMARK_REGION_COLUMN=
# NEWMARK_REGION_KEY_INDEX=8
# Newmark map — GE involvement OR-list: optional column name / index; otherwise the column
# whose header matches "GE Involvement" (see newmark_store._looks_like_ge_involvement_header).
# NEWMARK_GE_INVOLVEMENT_COLUMN=
# NEWMARK_GE_INVOLVEMENT_KEY_INDEX=

# Planning London Datahub (Elasticsearch guest API). Required for POST /api/planning/sync.
# Header name/value match the connection guide (guest read-only).
# PLANNING_LDH_BASE_URL=https://planningdata.london.gov.uk/api-guest
# PLANNING_LDH_HEADER_NAME=X-API-AllowRequest
# PLANNING_LDH_HEADER_VALUE=
# Optional: max hits per sync (1–500, default 50).
# PLANNING_LDH_SEARCH_SIZE=50
# Planning cache: pandas CSV (default backend/data/planning_applications.csv). No SQLite install needed.
# PLANNING_STORE_PATH=backend/data/planning_applications.csv
# Legacy only: old SQLite path was planning_london.db — it is migrated automatically once if the CSV is missing.
# PLANNING_DB_PATH=backend/data/planning_london.db
#
# Default applications query (see planning_ldh_client.applications_search_body):
# full = appeal date + B2/B8 + GIA filters (default in code if unset). match_all = smoke test, no filters.
# PLANNING_QUERY_MODE=full
# Temporary while validating the pipeline (delete this line to default to full in code, or set full explicitly):
# PLANNING_QUERY_MODE=match_all
# Appeal date lower bound for ``gt`` — LDH index uses dd/MM/yyyy (default 01/01/2025 if unset).
# PLANNING_APPEAL_START_AFTER=01/01/2025
# PLANNING_GIA_EXISTING_MIN=20000
# Floorspace query shape: LDH ``applications`` index uses ``object`` (not ``nested``). Default is off.
# Set to 1 only if your cluster maps ``existing_proposed_floorspace_details`` as nested.
# PLANNING_LDH_FLOORS_NESTED=0
# PLANNING_LDH_FLOORS_PATH=existing_proposed_floorspace_details
